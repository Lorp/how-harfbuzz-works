# Test font for “For applications”: f ligatures, two kerning pairs (one
# across a hyphen, where a line may break), ligature carets, and Arabic
# joining forms with tatweel.
languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem arab dflt;

table GDEF {
  GlyphClassDef [space hyphen T a c e f i n o x beh beh.init beh.medi
                 beh.fina tatweel], [f_i f_f f_f_i], , ;
  LigatureCaretByPos f_f_i 300 600;
  LigatureCaretByPos f_f 300;
  LigatureCaretByPos f_i 300;
} GDEF;

feature liga {
  script latn;
    sub f f i by f_f_i;
    sub f f by f_f;
    sub f i by f_i;
} liga;

feature kern {
  script latn;
    pos hyphen T -100;
    pos T o -80;
} kern;

feature init {
  script arab;
    sub beh by beh.init;
} init;

feature medi {
  script arab;
    sub beh by beh.medi;
} medi;

feature fina {
  script arab;
    sub beh by beh.fina;
} fina;
