# Test font for the GSUB chapter: ligatures, marks, joiners, context, alternates.
languagesystem DFLT dflt;
languagesystem latn dflt;

@MARKS = [acutecomb];

table GDEF {
  GlyphClassDef [f i l a e x a.alt1 a.alt2 a.alt3 e.init], [f_i f_l f_f f_f_i], @MARKS, ;
} GDEF;

feature liga {
  lookupflag IgnoreMarks;
  sub f i by f_i;
  sub f f i by f_f_i;
  sub f l by f_l;
  sub f f by f_f;
} liga;

feature salt {
  sub a from [a.alt1 a.alt2 a.alt3];
} salt;

lookup INIT {
  sub e by e.init;
} INIT;

feature calt {
  sub [space e.init] e' lookup INIT;
} calt;

feature ccmp {
  sub x by f i;
} ccmp;
