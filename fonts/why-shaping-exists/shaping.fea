# Test font for “Why shaping exists”: one ligature, one mark,
# Arabic joining forms, and a Devanagari conjunct.
languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn TRK;
languagesystem arab dflt;
languagesystem dev2 dflt;

@MARKS = [acutecomb virama];

table GDEF {
  GlyphClassDef [a e f i aacute beh beh.init beh.medi beh.fina lam lam.init
                 alef alef.fina ka ssa iMatra k_ssa],
                [f_f f_i lam_alef], @MARKS, ;
} GDEF;

# Latin: ff and fi ligatures, but no fi in Turkish, where it would hide
# the dot that tells i from ı.
feature liga {
  script latn;
  language dflt;
    lookup FF { sub f f by f_f; } FF;
    lookup FI { sub f i by f_i; } FI;
  language TRK exclude_dflt;
    lookup FF;
} liga;

# Arabic: the joining forms, and the mandatory lam-alef ligature.
feature init {
  script arab;
    sub beh by beh.init;
    sub lam by lam.init;
} init;

feature medi {
  script arab;
    sub beh by beh.medi;
} medi;

feature fina {
  script arab;
    sub beh by beh.fina;
    sub alef by alef.fina;
} fina;

feature rlig {
  script arab;
    sub lam.init alef.fina by lam_alef;
} rlig;

# Devanagari: KA + virama + SSA is the conjunct K.SSA.
feature akhn {
  script dev2;
    sub ka virama ssa by k_ssa;
} akhn;

# A mark-to-base attachment for the acute: its anchor is below its outline,
# and each base's is at the top of its outline, half its advance across.
markClass acutecomb <anchor 138 611> @TOP;

feature mark {
  script latn;
    pos base a <anchor 277 540> mark @TOP;
    pos base e <anchor 286 540> mark @TOP;
} mark;
